<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hooks, caret locator, text injection, focus tracking, layout detection. -->
  <PropertyGroup>
    <TargetFramework>$(ItmamWindowsTargetFramework)</TargetFramework>
    <!-- Restored for the MSIX architectures too (the packaged app is self-contained per RID). -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Itmam.Win32</RootNamespace>
    <!-- CsWin32 generates unsafe interop code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Itmam.Core\Itmam.Core.csproj" />
  </ItemGroup>

</Project>
