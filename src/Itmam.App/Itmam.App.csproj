<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinForms composition root: tray icon, suggestion popup, settings window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ItmamWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Itmam.App</RootNamespace>
    <AssemblyName>Itmam</AssemblyName>
    <!-- Generated by tools/IconGenerator from Tray/AppIconArt.cs. -->
    <ApplicationIcon>Assets\Itmam.ico</ApplicationIcon>
    <!-- MSIX (src/Itmam.Package): the Store has no .NET 10 desktop runtime, so packaged builds are
         self-contained, and ReadyToRun so start-up and the hook warm-up need little JIT. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <!-- Unconditional so restore fetches the ReadyToRun compiler; it only applies when publishing. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- User-facing strings: English (neutral) + Arabic. The Strings class is generated at build time. -->
    <EmbeddedResource Update="Resources\Strings.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="Itmam.App.Resources"
                      StronglyTypedClassName="Strings"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\itmam-ar.dict" Link="itmam-ar.dict" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\blocklist.txt" Link="blocklist.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\phrases.txt" Link="phrases.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\corrections.txt" Link="corrections.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Itmam.Core\Itmam.Core.csproj" />
    <ProjectReference Include="..\Itmam.Win32\Itmam.Win32.csproj" />
  </ItemGroup>

</Project>
