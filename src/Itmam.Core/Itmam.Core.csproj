<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic only: no Win32, no WinForms. Must stay unit-testable on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Restored for the MSIX architectures too (the packaged app is self-contained per RID). -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>Itmam.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Itmam.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded SQLite (native e_sqlite3 shipped inside the app; no server, no install). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
